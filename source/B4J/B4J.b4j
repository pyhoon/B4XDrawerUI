'Code module
#Region Project Attributes 
	'#ApplicationLabel: B4XDrawer
	'#Version: 1.0.0
	#MainFormWidth: 900
	#MainFormHeight: 600 
#End Region
#Region  Macros
'1 - Create $APPNAME$.b4a, $APPNAME$.b4i, $APPNAME$.b4j
'2 - Open $APPNAME$.b4j
'    -> Remove all macros for Step 1 to 5
'3 - Create B4XDrawerUI.b4xtemplate
'4 - Copy to B4X Additional Libraries folder
'5 - Check Release folder
#Macro: Title, Step 1.a, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\B4A\B4A.b4a&Args=%PROJECT%\..\B4A\$APPNAME$.b4a
'#Macro: Title, Step 1a, ide://run?File=%WINDIR%\explorer.exe&Args=%PROJECT%\..\B4A\$APPNAME$.b4a
#Macro: Title, Step 1.b, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\B4i\B4i.b4i&Args=%PROJECT%\..\B4i\$APPNAME$.b4i
'#Macro: Title, Step 1b, ide://run?File=%WINDIR%\explorer.exe&Args=%PROJECT%\..\B4i\$APPNAME$.b4i
#Macro: Title, Step 1.c, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\B4J.b4j&Args=%PROJECT%\$APPNAME$.b4j
#Macro: Title, Step 2, ide://run?File=%WINDIR%\explorer.exe&Args=%PROJECT%\$APPNAME$.b4j
#Macro: Title, Step 3, ide://run?File=%JAVABIN%\jar.exe&WorkingDirectory=..\..&Args=-cMf&Args=..\release\B4XDrawerUI.b4xtemplate&Args=B4A\Files&Args=B4i\Files&Args=B4J\Files&Args=B4A\$APPNAME$.b4a&Args=B4i\$APPNAME$.b4i&Args=B4J\$APPNAME$.b4j
#Macro: Title, Step 4, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\..\release\B4XDrawerUI.b4xtemplate&Args=%ADDITIONAL%\..\B4X
#Macro: Title, Step 5, ide://run?File=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\..\..\release
'For release
'#Macro: Title, Backup, ide://run?File=%JAVABIN%\jar.exe&WorkingDirectory=..&Args=-cMf&Args=%PROJECT_NAME%.zip&Args=Files&Args=*.b4j&Args=*.b4j.meta&Args=*.bas
#End Region
Sub Process_Globals
	Private fx As JFX
	Private xui As XUI
	Private Root As B4XView
	Private MainForm As Form
	Private Drawer As B4XDrawer
	Private CustomListView1 As CustomListView
	Private BtnMenu As B4XView
End Sub

Sub AppStart (Form1 As Form, Args() As String)
	MainForm = Form1
	MainForm.RootPane.LoadLayout("Root")
	MainForm.Show

	'Drawer.Initialize(Me, "Drawer", MainForm, 200dip)
	Drawer.Initialize(Me, "Drawer", Root, 200dip)
	Drawer.CenterPanel.LoadLayout("CenterPanel")
	Drawer.LeftPanel.LoadLayout("LeftPanel")
	CustomListView1.DefaultTextBackgroundColor = 0xFF77CAFF
	For i = 1 To 30
		CustomListView1.AddTextItem($"Item #${i}"$, "")
	Next
End Sub

Sub Root_Resize (Width As Double, Height As Double)
	If Drawer.IsInitialized Then Drawer.Resize(Width, Height)
End Sub

Private Sub BtnMenu_MouseClicked (EventData As MouseEvent)
	Drawer.LeftOpen = Not(Drawer.LeftOpen)
End Sub